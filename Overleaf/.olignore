# Local-only files: never pushed, pulled or deleted by the sync.
# A pattern without "/" matches at any depth; a pattern with "/" matches the full path.
# desktop.ini, *.pyc, __pycache__, .olauth and .olignore are always ignored by the client itself.
.pdf/*
.code
.olauth
*.py
*.ps1
*.log
*.pid
*.zip
desktop.ini
__pycache__
*.pyc
.git/*
.idea/*
Commands.txt
olsync/*
overleaf-sync-master/*
