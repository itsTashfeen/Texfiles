{
    "latex-workshop.latex.recipes": [
        {
            "name": "pdflatex (2x)",
            "tools": [
                "save-tex-pdf"
            ]
        },
        {
            "name": "xelatex",
            "tools": [
                "xelatex"
            ]
        },
        {
            "name": "lualatex",
            "tools": [
                "lualatex"
            ]
        }
    ],
    "latex-workshop.latex.tools": [
        {
            "name": "save-tex-pdf",
            "command": "C:/Python313/python.exe",
            "args": [
                "D:/Users/Tashfeen Omran/Documents/Not Synced/GitHub/MathTex/Overleaf/watch_tex_to_pdf.py",
                "--file",
                "%DOC%.tex",
                "--from-outdir",
                "%OUTDIR%"
            ],
            "env": {
                "PYTHONIOENCODING": "utf-8"
            }
        },
        {
            "name": "pdflatex",
            "command": "pdflatex",
            "args": [
                "-synctex=1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "-output-directory=%OUTDIR%",
                "%DOC%"
            ]
        },
        {
            "name": "xelatex",
            "command": "xelatex",
            "args": [
                "-synctex=1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "-output-directory=%OUTDIR%",
                "%DOC%"
            ]
        },
        {
            "name": "lualatex",
            "command": "lualatex",
            "args": [
                "-synctex=1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "-output-directory=%OUTDIR%",
                "%DOC%"
            ]
        }
    ],
    "latex-workshop.latex.recipe.default": "first",
    "latex-workshop.latex.outDir": "%TMPDIR%/latex-workshop/%DOCFILE%",
    "latex-workshop.latex.autoBuild.run": "onSave",
    "latex-workshop.view.pdf.viewer": "tab",
    "latex-workshop.latex.autoClean.run": "onBuilt",
    "latex-workshop.latex.clean.method": "glob"
}
